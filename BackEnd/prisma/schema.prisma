// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Models for Rukun Ternak frontend
model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  password   String
  fullName   String?   @map("full_name")
  role       String
  kelompokId Int?      @map("kelompok_id")
  kelompok   Kelompok? @relation(fields: [kelompokId], references: [id])

  @@index([kelompokId])
  @@index([role])
  @@map("users")
}

model Kelompok {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?
  kecamatan  String?
  desa       String?
  catatan    String?
  latitude   Float?
  longitude  Float?
  pic1Nik    String?  @map("pic1_nik")
  pic1Nama   String?  @map("pic1_nama")
  pic1Alamat String?  @map("pic1_alamat")
  pic1NoHp   String?  @map("pic1_no_hp")
  pic1Email  String?  @map("pic1_email")
  pic2Nik    String?  @map("pic2_nik")
  pic2Nama   String?  @map("pic2_nama")
  pic2Alamat String?  @map("pic2_alamat")
  pic2NoHp   String?  @map("pic2_no_hp")
  pic2Email  String?  @map("pic2_email")
  users      User[]
  laporan    Laporan[]
  hewanTernak HewanTernak[]
  updateTernak UpdateTernak[]

  @@index([name])
  @@map("kelompok")
}

model Laporan {
  id         Int       @id @default(autoincrement())
  jenis      String?
  kelompok   String?
  data       Json?
  userId     Int?      @map("user_id")
  kelompokId Int?      @map("kelompok_id")
  tanggal    DateTime  @default(now())
  kelompokRel Kelompok? @relation(fields: [kelompokId], references: [id])

  @@index([userId])
  @@index([kelompokId])
  @@index([jenis])
  @@index([tanggal])
  @@map("laporan")
}

model Notifikasi {
  id        Int      @id @default(autoincrement())
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifikasi")
}

model Berita {
  id          Int       @id @default(autoincrement())
  caption     String
  slug        String?   @unique
  content     String?   // HTML content from editor
  imageUrl    String    @map("image_url")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("berita")
}

model Banner {
  id        Int       @id @default(autoincrement())
  imageUrl  String    @map("image_url")
  createdAt DateTime  @default(now()) @map("created_at")
  isActive  Boolean   @default(true) @map("is_active")

  @@map("banners")
}

model HewanTernak {
  id              Int             @id @default(autoincrement())
  kelompokId      Int             @map("kelompok_id")
  kelompok        Kelompok        @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  jenisKelamin    String          @map("jenis_kelamin") // JANTAN, BETINA
  ras             String
  tanggalLahir    DateTime        @map("tanggal_lahir")
  bobot           Float?          // Bobot terakhir dalam kg
  status          String          @default("AKTIF") // AKTIF, MATI, TERJUAL
  idInduk         Int?            @map("id_induk")
  induk           HewanTernak?    @relation("AnakDariInduk", fields: [idInduk], references: [id])
  anak            HewanTernak[]   @relation("AnakDariInduk")
  idPejantan      Int?            @map("id_pejantan")
  pejantan        HewanTernak?    @relation("AnakDariPejantan", fields: [idPejantan], references: [id])
  anaknya         HewanTernak[]   @relation("AnakDariPejantan")
  riwayatBobot    RiwayatBobot[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([kelompokId])
  @@index([status])
  @@index([idInduk])
  @@index([idPejantan])
  @@index([tanggalLahir])
  @@map("hewan_ternak")
}

model RiwayatBobot {
  id              Int             @id @default(autoincrement())
  hewanId         Int             @map("hewan_id")
  hewan           HewanTernak     @relation(fields: [hewanId], references: [id], onDelete: Cascade)
  bobot           Float           // kg
  tanggalUpdate   DateTime        @default(now()) @map("tanggal_update")
  keterangan      String?
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([hewanId])
  @@map("riwayat_bobot")
}

model UpdateTernak {
  id              Int             @id @default(autoincrement())
  hewanId         Int             @map("hewan_id")
  kelompokId      Int             @map("kelompok_id")
  kelompok        Kelompok        @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  bobot           Float           // kg
  keterangan      String?
  tanggalUpdate   DateTime        @default(now()) @map("tanggal_update")
  status          String          @default("SELESAI") // SELESAI, DITOLAK
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([hewanId])
  @@index([kelompokId])
  @@index([tanggalUpdate])
  @@map("update_ternak")
}

