generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// Models for Rukun Ternak frontend
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String?  @map("full_name")
  role      String
  kelompok  String?
}

model Kelompok {
  id   Int    @id @default(autoincrement())
  name String
}

model Laporan {
  id       Int      @id @default(autoincrement())
  jenis    String?
  kelompok String?
  data     Json?
  tanggal  DateTime @default(now())
}

model Notifikasi {
  id        Int      @id @default(autoincrement())
  message   String?
  createdAt DateTime @default(now()) @map("created_at")
}

